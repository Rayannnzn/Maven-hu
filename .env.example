# Lead form email delivery (app/api/leads/route.ts)
# Copy to .env.local and fill in. Never commit .env.local.

# Resend API key - https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives lead notifications
LEAD_TO_EMAIL=info@mavendmv.com

# Sender address. The domain MUST be verified in Resend (Domains -> Add Domain,
# then add the SPF/DKIM DNS records at your registrar). A friendly name is optional.
LEAD_FROM_EMAIL=Maven Home Services <leads@mavendmv.com>

# Optional: additional address BCC-d on every lead notification
# LEAD_BCC_EMAIL=
